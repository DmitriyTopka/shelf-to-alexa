{
  "name": "shelf-to-alexa",
  "version": "0.1.0",
  "description": "Turn any Shopify catalog into an MCP server for Alexa+: search, compare, honest compatibility with quotes, device closet, two-step orders.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "shelf-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "shopify",
    "ecommerce",
    "mcp-apps"
  ],
  "scripts": {
    "start": "tsx examples/serve.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitriyTopka/shelf-to-alexa.git"
  },
  "homepage": "https://github.com/DmitriyTopka/shelf-to-alexa#readme",
  "engines": {
    "node": ">=22"
  }
}
